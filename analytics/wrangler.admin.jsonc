{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "eightold-analytics-admin",
  "main": "admin/src/index.js",
  "compatibility_date": "2026-07-16",
  "vars": {
    "SITE_ID": "eightold",
    "ACCESS_TEAM_DOMAIN": "https://replace-me.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-cloudflare-access-aud"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eightold-analytics",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "admin/public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
